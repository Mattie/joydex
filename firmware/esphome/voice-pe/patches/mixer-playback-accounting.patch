+static inline uint32_t atomic_subtract_clamped(std::atomic<uint32_t> &value, uint32_t amount) {
+  uint32_t current = value.load(std::memory_order_acquire);
+  uint32_t subtracted = 0;
+  if (current > 0) {
+    uint32_t next;
+    do {
+      subtracted = std::min(amount, current);
+      next = current - subtracted;
+    } while (!value.compare_exchange_weak(current, next, std::memory_order_release, std::memory_order_acquire));
+  }
+  return subtracted;
+}
