<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Joydex.Contracts\Joydex.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Joydex.Core\Joydex.Core.csproj" />
    <ProjectReference Include="..\..\src\Joydex.RuntimeHost\Joydex.RuntimeHost.csproj" />
    <ProjectReference Include="..\..\src\Joydex.VoiceWorker\Joydex.VoiceWorker.csproj" />
    <ProjectReference Include="..\Joydex.ProcessProbe\Joydex.ProcessProbe.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyProcessProbe" AfterTargets="Build">
    <ItemGroup>
      <_ProcessProbeFiles Include="..\Joydex.ProcessProbe\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProcessProbeFiles)"
          DestinationFiles="@(_ProcessProbeFiles->'$(OutputPath)ProcessProbe\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
